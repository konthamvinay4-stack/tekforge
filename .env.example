# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only Kubernetes/Tekton settings (never use NEXT_PUBLIC_ for these)
# For the direct MVP integration, use the GKE Kubernetes API endpoint.
TEKTON_API_URL=https://YOUR_GKE_KUBERNETES_API_SERVER
TEKTON_BEARER_TOKEN=YOUR_SHORT_LIVED_KUBERNETES_SERVICE_ACCOUNT_TOKEN
TEKFORGE_TEKTON_NAMESPACE=tekforge
TEKFORGE_TEKTON_SERVICE_ACCOUNT=tekforge-build
