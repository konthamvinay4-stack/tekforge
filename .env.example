# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Optional: GitHub token for private repositories and higher API rate limits.
# Never expose this to the browser.
GITHUB_TOKEN=YOUR_GITHUB_TOKEN

# Cluster agent bootstrap signing secret. Keep this server-only and rotate it if compromised.
TEKFORGE_AGENT_SIGNING_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
TEKFORGE_AGENT_IMAGE=ghcr.io/konthamvinay4-stack/tekforge-agent:latest

# Legacy/local direct Tekton API settings. The SaaS path uses the TekForge Agent instead.
TEKTON_API_URL=http://127.0.0.1:8001
TEKTON_BEARER_TOKEN=
TEKFORGE_TEKTON_NAMESPACE=tekforge
