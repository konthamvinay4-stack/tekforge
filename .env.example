# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional: GitHub token for private repositories and higher API rate limits.
# Never expose this to the browser.
GITHUB_TOKEN=YOUR_GITHUB_TOKEN

# Server-only Kubernetes/Tekton settings (do not expose these to the browser)
# For local Docker Desktop development, run: kubectl proxy --port=8001
TEKTON_API_URL=http://127.0.0.1:8001
# Leave empty when using kubectl proxy locally.
TEKTON_BEARER_TOKEN=
TEKFORGE_TEKTON_NAMESPACE=tekforge
