# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only Kubernetes/Tekton settings (do not expose these to the browser)
TEKTON_API_URL=https://YOUR_TEKTON_CLUSTER
TEKTON_BEARER_TOKEN=YOUR_LEAST_PRIVILEGE_SERVICE_ACCOUNT_TOKEN
TEKFORGE_TEKTON_NAMESPACE=tekforge
